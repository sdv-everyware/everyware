// The crates vsidlc generates from the catalog, one per bundle: publisher and subscriber
// descriptors (PublisherDescriptors::<Weather>::WEATHER, ...) and the bundle's client. Nothing
// here is hand-written; add a bundle to everyware.vsidl and a pair of modules below.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "everyware_generated_bundle_defaults",
    use_expansive_default_srcs: false,
    rustlibs: [
        "libprotobuf",
        "liblog_rust",
        "libsdv_rs",
        "libfutures",
        "libeveryware_catalog",
        "libsdv_proto_reflection_rs",
    ],
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    vendor_available: true,
    product_available: true,
    min_sdk_version: "35",
}

genrule {
    name: "libsdv_mw_rs_com_everyware_weather_service_bundle_rs",
    tools: ["extract_catalog_zip"],
    srcs: [":vsidlc_everyware_catalog_files"],
    out: ["service_bundle.rs"],
    cmd: "$(location extract_catalog_zip) $(in) --service-bundle com.everyware WeatherServiceBundle",
}

rust_library {
    name: "libsdv_mw_rs_com_everyware_weather_service_bundle",
    crate_name: "sdv_mw_rs_com_everyware_weather_service_bundle",
    defaults: ["everyware_generated_bundle_defaults"],
    crate_root: ":libsdv_mw_rs_com_everyware_weather_service_bundle_rs{service_bundle.rs}",
    srcs: [":libsdv_mw_rs_com_everyware_weather_service_bundle_rs"],
}

genrule {
    name: "libsdv_mw_rs_com_everyware_news_service_bundle_rs",
    tools: ["extract_catalog_zip"],
    srcs: [":vsidlc_everyware_catalog_files"],
    out: ["service_bundle.rs"],
    cmd: "$(location extract_catalog_zip) $(in) --service-bundle com.everyware NewsServiceBundle",
}

rust_library {
    name: "libsdv_mw_rs_com_everyware_news_service_bundle",
    crate_name: "sdv_mw_rs_com_everyware_news_service_bundle",
    defaults: ["everyware_generated_bundle_defaults"],
    crate_root: ":libsdv_mw_rs_com_everyware_news_service_bundle_rs{service_bundle.rs}",
    srcs: [":libsdv_mw_rs_com_everyware_news_service_bundle_rs"],
}

genrule {
    name: "libsdv_mw_rs_com_everyware_wifi_service_bundle_rs",
    tools: ["extract_catalog_zip"],
    srcs: [":vsidlc_everyware_catalog_files"],
    out: ["service_bundle.rs"],
    cmd: "$(location extract_catalog_zip) $(in) --service-bundle com.everyware WifiServiceBundle",
}

rust_library {
    name: "libsdv_mw_rs_com_everyware_wifi_service_bundle",
    crate_name: "sdv_mw_rs_com_everyware_wifi_service_bundle",
    defaults: ["everyware_generated_bundle_defaults"],
    rustlibs: ["libcom_everyware_wifi_service_rpc_rs"],
    crate_root: ":libsdv_mw_rs_com_everyware_wifi_service_bundle_rs{service_bundle.rs}",
    srcs: [":libsdv_mw_rs_com_everyware_wifi_service_bundle_rs"],
}

genrule {
    name: "libsdv_mw_rs_com_everyware_dashboard_service_bundle_rs",
    tools: ["extract_catalog_zip"],
    srcs: [":vsidlc_everyware_catalog_files"],
    out: ["service_bundle.rs"],
    cmd: "$(location extract_catalog_zip) $(in) --service-bundle com.everyware DashboardServiceBundle",
}

rust_library {
    name: "libsdv_mw_rs_com_everyware_dashboard_service_bundle",
    crate_name: "sdv_mw_rs_com_everyware_dashboard_service_bundle",
    defaults: ["everyware_generated_bundle_defaults"],
    rustlibs: [
        "libcom_everyware_wifi_service_rpc_rs",
        "libcom_everyware_matter_service_rpc_rs",
        // the device's settings (user_preferences' services)
        "libuser_preferences_api_stable",
        "libcom_android_sdv_user_preferences_user_preferences_management_service_rpc_rs",
        "libcom_android_sdv_user_preferences_view_change_notifier_rpc_rs",
        "libcom_android_sdv_user_preferences_user_controllable_user_controllable_service_rpc_rs",
    ],
    crate_root: ":libsdv_mw_rs_com_everyware_dashboard_service_bundle_rs{service_bundle.rs}",
    srcs: [":libsdv_mw_rs_com_everyware_dashboard_service_bundle_rs"],
}

// The RPC service crate (vsidlc --rpc): the server trait and the client of WifiService.
genrule {
    name: "libcom_everyware_wifi_service_rpc_rs_src",
    tools: ["extract_catalog_zip"],
    srcs: [":vsidlc_everyware_catalog_files"],
    out: ["lib.rs"],
    cmd: "$(location extract_catalog_zip) $(in) --rpc com.everyware WifiService",
}

rust_library {
    name: "libcom_everyware_wifi_service_rpc_rs",
    crate_name: "com_everyware_wifi_service_rpc",
    crate_root: ":libcom_everyware_wifi_service_rpc_rs_src{lib.rs}",
    srcs: [":libcom_everyware_wifi_service_rpc_rs_src"],
    use_expansive_default_srcs: false,
    rustlibs: [
        "libsdv_rs",
        "libeveryware_catalog",
    ],
    proc_macros: ["libasync_trait"],
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    vendor_available: true,
    product_available: true,
    min_sdk_version: "35",
}

genrule {
    name: "libsdv_mw_rs_com_everyware_matter_service_bundle_rs",
    tools: ["extract_catalog_zip"],
    srcs: [":vsidlc_everyware_catalog_files"],
    out: ["service_bundle.rs"],
    cmd: "$(location extract_catalog_zip) $(in) --service-bundle com.everyware MatterServiceBundle",
}

rust_library {
    name: "libsdv_mw_rs_com_everyware_matter_service_bundle",
    crate_name: "sdv_mw_rs_com_everyware_matter_service_bundle",
    defaults: ["everyware_generated_bundle_defaults"],
    rustlibs: ["libcom_everyware_matter_service_rpc_rs"],
    crate_root: ":libsdv_mw_rs_com_everyware_matter_service_bundle_rs{service_bundle.rs}",
    srcs: [":libsdv_mw_rs_com_everyware_matter_service_bundle_rs"],
}

// The RPC service crate (vsidlc --rpc): the server trait and the client of MatterService.
genrule {
    name: "libcom_everyware_matter_service_rpc_rs_src",
    tools: ["extract_catalog_zip"],
    srcs: [":vsidlc_everyware_catalog_files"],
    out: ["lib.rs"],
    cmd: "$(location extract_catalog_zip) $(in) --rpc com.everyware MatterService",
}

rust_library {
    name: "libcom_everyware_matter_service_rpc_rs",
    crate_name: "com_everyware_matter_service_rpc",
    crate_root: ":libcom_everyware_matter_service_rpc_rs_src{lib.rs}",
    srcs: [":libcom_everyware_matter_service_rpc_rs_src"],
    use_expansive_default_srcs: false,
    rustlibs: [
        "libsdv_rs",
        "libeveryware_catalog",
    ],
    proc_macros: ["libasync_trait"],
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    vendor_available: true,
    product_available: true,
    min_sdk_version: "35",
}

// SystemServiceBundle's crate names user_preferences' services, not the catalog's messages:
// no defaults, its own libraries, and no vendor variant (user_preferences has none).
genrule {
    name: "libsdv_mw_rs_com_everyware_system_service_bundle_rs",
    tools: ["extract_catalog_zip"],
    srcs: [":vsidlc_everyware_catalog_files"],
    out: ["service_bundle.rs"],
    cmd: "$(location extract_catalog_zip) $(in) --service-bundle com.everyware SystemServiceBundle",
}

rust_library {
    name: "libsdv_mw_rs_com_everyware_system_service_bundle",
    crate_name: "sdv_mw_rs_com_everyware_system_service_bundle",
    use_expansive_default_srcs: false,
    crate_root: ":libsdv_mw_rs_com_everyware_system_service_bundle_rs{service_bundle.rs}",
    srcs: [":libsdv_mw_rs_com_everyware_system_service_bundle_rs"],
    rustlibs: [
        "libprotobuf",
        "liblog_rust",
        "libsdv_rs",
        "libfutures",
        "libsdv_proto_reflection_rs",
        "libuser_preferences_api_stable",
        "libcom_android_sdv_user_preferences_user_controllable_user_controllable_service_rpc_rs",
        "libcom_android_sdv_user_preferences_user_preferences_registry_service_rpc_rs",
    ],
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    product_available: true,
    min_sdk_version: "35",
}
