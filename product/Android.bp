package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

// /product/etc/service_bundle_contexts: the SELinux domain of the bundles that have their own.
prebuilt_etc {
    name: "service_bundle_contexts",
    src: "service_bundle_contexts",
    filename: "service_bundle_contexts",
    product_specific: true,
}
