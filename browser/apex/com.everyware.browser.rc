# The Debian root of the panel's browser: this APEX's rootfs.erofs, read-only, where
# everyware-browser.sh enters it. On the trigger that starts the panel; the browser starts when
# the panel runs, a later event, so the root is there before it.
#   nosuid   the root has set-user-ID programs (su, mount, passwd); the browser needs none
#   context  its own file type (the device's everyware_browser.te), for the rules of an
#            enforcing board
on property:apex.all.ready=true
    mkdir /mnt/vendor/everyware_browser 0755 root root
    mount erofs loop@/apex/com.everyware.browser/etc/fs/rootfs.erofs /mnt/vendor/everyware_browser ro nosuid nodev context=u:object_r:everyware_browser_root_file:s0
    # the browser's home: the root is read-only, its user keeps its logs and WebKit's data here
    mkdir /data/vendor/everyware_browser 0700 oem_2900 oem_2900
