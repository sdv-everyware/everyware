// com.everyware.browser: the Debian root of the panel's experimental browser (Cog, WPE WebKit)
// as one read-only file system image, etc/fs/rootfs.erofs, as com.android.virt carries the
// images of Microdroid. The APEX's rc mounts it; everyware-browser.sh enters it. In the product
// only with EVERYWARE_EXPERIMENTAL_BROWSER=true (product/everyware.mk); docs/project/browser.md.
//
// The image is not in git. scripts/browser-root.sh --export makes it on a board of the
// architecture, into prebuilt/<arch>/ beside its manifest. The build checks both against
// root.lock (check-root.sh: the image matches its manifest, made from the locked versions).
// The modules that need the image exist only with the flag (soong config everyware
// experimental_browser, set by everyware.mk); build/tasks/browser.mk stops a build with the
// flag that has no image of its architecture.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex {
    name: "com.everyware.browser",
    enabled: select(soong_config_variable("everyware", "experimental_browser"), {
        true: true,
        default: false,
    }),
    manifest: "apex_manifest.json",
    file_contexts: "file_contexts",
    key: "com.everyware.browser.key",
    updatable: false,
    // in /vendor/apex, beside the browser's service and scripts
    soc_specific: true,
    prebuilts: [
        "com.everyware.browser.rc",
        "com.everyware.browser.rootfs",
    ],
    arch: {
        riscv64: {
            enabled: false,
        },
    },
}

// Test key, generated for this project. A device that ships signs with its own.
apex_key {
    name: "com.everyware.browser.key",
    public_key: "keys/com.everyware.browser.avbpubkey",
    private_key: "keys/com.everyware.browser.pem",
}

prebuilt_etc {
    name: "com.everyware.browser.rc",
    src: "com.everyware.browser.rc",
    installable: false,
}

prebuilt_etc {
    name: "com.everyware.browser.rootfs",
    enabled: select(soong_config_variable("everyware", "experimental_browser"), {
        true: true,
        default: false,
    }),
    filename: "rootfs.erofs",
    relative_install_path: "fs",
    installable: false,
    arch: {
        arm64: {
            src: ":com.everyware.browser.rootfs-arm64",
        },
        x86_64: {
            src: ":com.everyware.browser.rootfs-amd64",
        },
    },
}

// The exported image of each architecture. srcs is a glob: the image is not in git, and a tree
// without it is still read.
genrule {
    name: "com.everyware.browser.rootfs-arm64",
    enabled: select(soong_config_variable("everyware", "experimental_browser"), {
        true: true,
        default: false,
    }),
    srcs: ["prebuilt/arm64/*"],
    tool_files: [
        "check-root.sh",
        "root.lock",
    ],
    out: ["rootfs.erofs"],
    cmd: "$(location check-root.sh) arm64 $(location root.lock) $(out) $(in)",
}

genrule {
    name: "com.everyware.browser.rootfs-amd64",
    enabled: select(soong_config_variable("everyware", "experimental_browser"), {
        true: true,
        default: false,
    }),
    srcs: ["prebuilt/amd64/*"],
    tool_files: [
        "check-root.sh",
        "root.lock",
    ],
    out: ["rootfs.erofs"],
    cmd: "$(location check-root.sh) amd64 $(location root.lock) $(out) $(in)",
}
