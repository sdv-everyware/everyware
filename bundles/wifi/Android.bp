// WifiServiceBundle: the outdoor wifi from Open-Meteo, published on the topic "wifi".
// The module is shaped as vsidlc generates a service bundle (vsidlc --services).

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_ffi_shared {
    name: "libeveryware_wifi_bundle",
    crate_name: "everyware_wifi_bundle",
    srcs: ["src/lib.rs"],
    defaults: ["sdv_tracing@rust_defaults"],
    rustlibs: [
        "libtokio",
        "libtokio_util",
        "libfutures",
        "libfutures_util",
        "libsdv_rs",
        "libsdv_mw_rs_com_everyware_wifi_service_bundle",
        "liblog_rust",
        "libprotobuf",
        "libeveryware_catalog",
        "libsdv_status_rs",
        "libcom_everyware_wifi_service_rpc_rs",
    ],
    proc_macros: ["libasync_trait"],
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    // Service bundle packages are /product APEXes.
    product_specific: true,
    min_sdk_version: "35",
    arch: {
        riscv64: {
            enabled: false,
        },
    },
}

// The control-interface protocol and its parsers, on the host.
rust_test_host {
    name: "everyware_wpa_ctrl_test",
    crate_name: "wpa_ctrl",
    srcs: ["src/wpa_ctrl.rs"],
    rustlibs: ["libtokio"],
    test_suites: ["general-tests"],
}
