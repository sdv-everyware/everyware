// DashboardServiceBundle: the bridge from the house's topics to the harry process.
// The module is shaped as vsidlc generates a service bundle (vsidlc --services).

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_ffi_shared {
    name: "libeveryware_dashboard_bundle",
    crate_name: "everyware_dashboard_bundle",
    srcs: ["src/lib.rs"],
    defaults: ["sdv_tracing@rust_defaults"],
    rustlibs: [
        "libtokio",
        "libtokio_util",
        "libanyhow",
        "libfutures",
        "libfutures_util",
        "libsdv_rs",
        "libsdv_mw_rs_com_everyware_dashboard_service_bundle",
        "liblog_rust",
        "libprotobuf",
        "libeveryware_catalog",
        "libsdv_status_rs",
        "libcom_everyware_wifi_service_rpc_rs",
        "libcom_everyware_matter_service_rpc_rs",
        // the local link to the harry process (proto/dashboard.proto)
        "libgrpcio",
        "libeveryware_dashboard_grpc",
        // Wi-Fi to the panel over binder (src/screen.rs, interfaces/screen)
        "libbinder_rs",
        "com.everyware.screen-V1-rust",
    ],
    proc_macros: ["libasync_trait"],
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    // Service bundle packages are /product APEXes.
    product_specific: true,
    min_sdk_version: "35",
    arch: {
        riscv64: {
            enabled: false,
        },
    },
}
