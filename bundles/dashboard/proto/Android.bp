// The gRPC contract between the dashboard bundle (client) and the harry process (server).

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_protobuf {
    name: "libeveryware_dashboard_grpc",
    crate_name: "everyware_dashboard_grpc",
    grpc_protos: ["dashboard.proto"],
    protos: [":everyware_catalog_protos_only"],
    proto_flags: [
        "-I vendor/sdv-everyware/everyware/bundles/dashboard/proto",
        "-I vendor/sdv-everyware/everyware/catalog",
        "-I system/software_defined_vehicle/vsidl/language/src/protos",
    ],
    source_stem: "everyware_dashboard_grpc_source",
    rustlibs: ["libvsidl_v1_proto_rs"],
    host_supported: true,
    vendor_available: true,
    product_available: true,
    min_sdk_version: "29",
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    arch: {
        riscv64: {
            enabled: false,
        },
    },
}
