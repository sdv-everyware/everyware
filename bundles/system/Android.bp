// SystemServiceBundle: owns the system settings of the device (the time zone, the clock's format) in
// SDV's user_preferences and applies them.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_ffi_shared {
    name: "libeveryware_system_bundle",
    crate_name: "everyware_system_bundle",
    srcs: ["src/lib.rs"],
    defaults: ["sdv_tracing@rust_defaults"],
    rustlibs: [
        "libtokio",
        "libtokio_util",
        "libanyhow",
        "libfutures",
        "libfutures_util",
        "libsdv_rs",
        "libsdv_mw_rs_com_everyware_system_service_bundle",
        "liblog_rust",
        "libprotobuf",
        "libsdv_status_rs",
        // the clock's format, kept in the bundle's directory (libs/bundle-store)
        "libeveryware_bundle_store",
        "libsdv_comms_rs",
        "libuser_preferences_api_stable",
        "libcom_android_sdv_user_preferences_user_controllable_user_controllable_service_rpc_rs",
        "libcom_android_sdv_user_preferences_user_preferences_registry_service_rpc_rs",
    ],
    proc_macros: ["libasync_trait"],
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    product_specific: true,
    min_sdk_version: "35",
    arch: {
        riscv64: {
            enabled: false,
        },
    },
}
