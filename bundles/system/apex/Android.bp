// com.everyware.system: SystemServiceBundle, its manifest, its orchestration config and its authz policy.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

apex {
    name: "com.everyware.system",
    manifest: "apex_manifest.json",
    file_contexts: "file_contexts",
    key: "com.everyware.system.key",
    prebuilts: [
        "com.everyware.system.service_bundles_manifest",
        "com.everyware.system.linker_config",
        "com.everyware.system.orch",
        "com.everyware.system.permissions",
    ],
    updatable: false,
    product_specific: true,
    arch: {
        arm64: {
            native_shared_libs: ["libeveryware_system_bundle"],
        },
        x86_64: {
            native_shared_libs: ["libeveryware_system_bundle"],
        },
        riscv64: {
            enabled: false,
        },
    },
}

// Test key, generated for this project. A device that ships signs with its own.
apex_key {
    name: "com.everyware.system.key",
    public_key: "keys/com.everyware.system.avbpubkey",
    private_key: "keys/com.everyware.system.pem",
}

prebuilt_etc {
    name: "com.everyware.system.service_bundles_manifest",
    src: "sdv_service_bundles_manifest.textproto",
    filename: "sdv_service_bundles_manifest.textproto",
    installable: false,
}

linker_config {
    name: "com.everyware.system.linker_config",
    src: "linker.config.json",
    installable: false,
}

prebuilt_etc {
    name: "com.everyware.system.orch",
    src: "SystemServiceBundleOrchestration.textproto",
    filename: "SystemServiceBundleOrchestration.textproto",
    sub_dir: "orch",
    installable: false,
}

// The authz policy of the bundle, read by the agents at boot.
prebuilt_etc {
    name: "com.everyware.system.permissions",
    src: "permissions.textproto",
    sub_dir: "permissions",
    filename: "system_permissions.textproto",
    installable: false,
}
