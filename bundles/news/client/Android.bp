// The news client of the news bundle (src/lib.rs): Hacker News and the articles' meta tags.
// A crate of its own so the parsing has a host test without SDV.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_defaults {
    name: "everyware_news_client_defaults",
    crate_name: "everyware_news_client",
    srcs: ["src/lib.rs"],
    rustlibs: [
        "liblog_rust",
        "libserde_json",
        // the thumbnails: JPEG and PNG decoding, crop and scale
        "libimage",
        // HTTPS (libs/https): hyper over tokio-openssl over BoringSSL
        "libeveryware_https",
    ],
}

rust_library {
    name: "libeveryware_news_client",
    defaults: ["everyware_news_client_defaults"],
    // the host tests of the clients that use it
    host_supported: true,
    // the news bundle is a /product APEX
    product_available: true,
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    arch: {
        riscv64: {
            enabled: false,
        },
    },
}

rust_test_host {
    name: "everyware_news_client_test",
    defaults: ["everyware_news_client_defaults"],
    test_suites: ["general-tests"],
}
