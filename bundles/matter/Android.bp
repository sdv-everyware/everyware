// MatterServiceBundle: the house's Matter fabric, its devices published on the topic
// "matter-devices" and the MatterService RPC. The module is shaped as vsidlc generates a service
// bundle (vsidlc --services).

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_ffi_shared {
    name: "libeveryware_matter_bundle",
    crate_name: "everyware_matter_bundle",
    srcs: ["src/lib.rs"],
    defaults: ["sdv_tracing@rust_defaults"],
    rustlibs: [
        "libtokio",
        "libtokio_util",
        "libfutures",
        "libfutures_util",
        "libsdv_rs",
        "libsdv_mw_rs_com_everyware_matter_service_bundle",
        "liblog_rust",
        "libprotobuf",
        "libeveryware_catalog",
        "libsdv_status_rs",
        "libcom_everyware_matter_service_rpc_rs",
        // the controller (client/): rs-matter
        "libeveryware_matter_client",
    ],
    proc_macros: ["libasync_trait"],
    // Every Rust dependency as an rlib, as SDV's sample bundles link (samples/health): the
    // controller and rs-matter are rlibs, and one crate (log) linked as a dylib too would be
    // two copies of it.
    prefer_rlib: true,
    // with the rlibs every SDV FFI library their code calls is a NEEDED of this one (as the
    // sample links): as-needed linking dropped libsdv_comms_sd_ffi and _id_ffi
    ld_flags: ["-Wl,--no-as-needed"],
    apex_available: [
        "//apex_available:platform",
        "//apex_available:anyapex",
    ],
    // Service bundle packages are /product APEXes.
    product_specific: true,
    min_sdk_version: "35",
    arch: {
        riscv64: {
            enabled: false,
        },
    },
}
