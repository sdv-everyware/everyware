// fbgrab: dumps the active KMS primary-plane framebuffer(s) of a DRM card
// to raw RGBA files for inspection on boards without SurfaceFlinger.

package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

rust_binary {
    name: "fbgrab",
    crate_name: "fbgrab",
    srcs: ["src/main.rs"],
    edition: "2021",
    rustlibs: [
        "libdrm_ffi",
        "libdrm_fourcc",
        "libdrm_rust",
        "liblibc",
    ],
    // Self-contained binary so it runs from /data/local/tmp without extra LD_LIBRARY_PATH.
    prefer_rlib: true,
}

rust_test_host {
    name: "fbgrab_test",
    crate_name: "fbgrab_test",
    srcs: ["src/convert.rs"],
    edition: "2021",
    rustlibs: [
        "libdrm_fourcc",
    ],
    test_options: {
        unit_test: true,
    },
}
